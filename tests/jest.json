{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testRegex": "tests/unit/.*.spec.ts$",
    "transform": {
        "^.+.(t|j)s$": [
            "ts-jest",
            {
                "isolatedModules": true,
                "diagnostics": false
            }
        ]
    },
    "collectCoverageFrom": [
        "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    }
}