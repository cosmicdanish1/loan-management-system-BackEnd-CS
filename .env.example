# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration - PostgreSQL Only
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_DATABASE=loan_management_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@loanmanagement.com

# Backup Configuration
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
# Support "Raise a Query" desk (leave blank to disable; queries are still saved and sent later)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ES
JIRA_ISSUE_TYPE=Task
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram topic (message_thread_id) per alert channel; blank = post to the group's General topic
TELEGRAM_TOPIC_QUERIES=
TELEGRAM_TOPIC_ERRORS=
TELEGRAM_TOPIC_ACTIVITY=
TELEGRAM_TOPIC_BUSINESS=
TELEGRAM_TOPIC_DIGEST=

# Telegram alerts (errors, logins, backups, licence, daily digest)
# ALERT_ENV: set to "production" on the live server; anything else tags every message e.g. [dev]
ALERT_ENV=dev
ALERTS_ENABLED=true
ALERT_STARTUP=true
ALERT_DIGEST_HOUR=8
SLOW_API_MS=5000

# Used only by local test scripts (never commit a real value)
DEV_ADMIN_PASSWORD=

# Discord alerts (free; one webhook per channel). Create in Discord: channel settings > Integrations > Webhooks > New Webhook > Copy URL.
# Leave blank to disable a channel. DISCORD_WEBHOOK_URL is one fallback used for every channel without its own URL.
DISCORD_WEBHOOK_QUERIES=
DISCORD_WEBHOOK_ERRORS=
DISCORD_WEBHOOK_ACTIVITY=
DISCORD_WEBHOOK_BUSINESS=
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_URL=
# Reserved for Jira event notifications (not used by the app yet)
DISCORD_WEBHOOK_JIRA=
